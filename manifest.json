{
  "manifest_version": 3,
  "name": "OLX Chat Inline",
  "version": "1.0.0",
  "description": "Abre o chat da OLX dentro da propria pagina do anuncio, sem abrir uma nova janela.",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "minimum_chrome_version": "111",
  "permissions": [
    "declarativeNetRequestWithHostAccess",
    "storage"
  ],
  "host_permissions": [
    "*://*.olx.com.br/*"
  ],
  "background": {
    "service_worker": "src/background.js"
  },
  "declarative_net_request": {
    "rule_resources": [
      {
        "id": "chat_frame",
        "enabled": true,
        "path": "rules/chat-frame.json"
      },
      {
        "id": "page_csp",
        "enabled": false,
        "path": "rules/page-csp.json"
      }
    ]
  },
  "content_scripts": [
    {
      "matches": [
        "*://*.olx.com.br/*"
      ],
      "exclude_matches": [
        "*://chat.olx.com.br/*"
      ],
      "js": [
        "src/main-world.js"
      ],
      "world": "MAIN",
      "run_at": "document_start",
      "all_frames": false
    },
    {
      "matches": [
        "*://*.olx.com.br/*"
      ],
      "exclude_matches": [
        "*://chat.olx.com.br/*"
      ],
      "js": [
        "src/content.js"
      ],
      "run_at": "document_start",
      "all_frames": false
    }
  ]
}
